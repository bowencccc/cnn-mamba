__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Large inputs, generated windows, checkpoints and raw score arrays stay outside Git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/scores/*
!artifacts/scores/.gitkeep
artifacts/phase_predictions/*
!artifacts/phase_predictions/.gitkeep
artifacts/cds_predictions/
artifacts/joint_frame_predictions/
artifacts/uniann_coding_scores/
data/propensity/
/runs/
/work/
*.pt
*.npy
*.npz
*.fa
*.fna
*.fai
*.gff
*.gtf
*.csv
*.tsv.gz

# Small inference-only checkpoints intentionally published for reproducible tests.
!models/*.pt
/results/**/run.log
/results/**/runner.log
/results/*.runner.log
/results/**/*.runner.log
/results/*.postprocess.log
/results/**/*.postprocess.log
/results/**/*.gffcompare.log
/results/**/*.gffread.log
/results/**/*.tracking
/results/**/*.loci
/results/**/*.refmap
/results/**/*.tmap
/results/**/*.stats

# Curated result tables under results/ are intentionally versioned.
!results/**/*.tsv.gz
